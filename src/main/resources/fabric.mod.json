{
	"schemaVersion": 1,
	"id": "claudecraft",
	"version": "${version}",
	"name": "ClaudeCraft",
	"description": "Runs a local MCP server that lets Claude execute commands, inspect registries and control in-world agents that can take screenshots.",
	"authors": [
		"Kuchukov"
	],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"k4k.claudecraft.ClaudeCraft"
		],
		"client": [
			"k4k.claudecraft.ClaudeCraftClient"
		]
	},
	"mixins": [
		"claudecraft.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.10",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}
